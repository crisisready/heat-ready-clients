  Fetch every metrics row for a project, paging
automatically, and return them as one combined data frame.

This is the "download all of a project's data" helper: it walks
\code{limit}/\code{offset} for you.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{HeatReadyClient$iter_metrics(
  project_id,
  page_size = 500,
  date_from = NULL,
  date_to = NULL,
  include_forecast = FALSE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{project_id}}{Project identifier.}
      \item{\code{page_size}}{Rows requested per page (default 500).}
      \item{\code{date_from}}{Filter -- only rows on/after this local date.}
      \item{\code{date_to}}{Filter -- only rows on/before this local date.}
      \item{\code{include_forecast}}{Include forecast rows (default \code{FALSE}).}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A data frame with one row per polygon per local date.
  }
}

